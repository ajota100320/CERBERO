            "error": f"Ya existe un usuario con el email {email}",
            "success": None,
        }, status_code=400)

    # Validar rol
    try:
        rol_enum = RolUsuario(rol)
    except ValueError:
        raise HTTPException(status_code=400, detail=f"Rol inválido: {rol}")

    # Encriptar contraseña con bcrypt (get_password_hash)
