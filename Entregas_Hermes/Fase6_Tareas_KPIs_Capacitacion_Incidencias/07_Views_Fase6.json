          "Name": "KPIs Activos Totales",
          "Expression": "COUNT(FILTER(\"KPI_Definiciones\", [Es_Activa] = TRUE))",
          "Icon": "bar-chart-2",
          "Color": "Info"
        },
        {
          "Name": "KPIs en Rojo (Críticos)",
          "Expression": "COUNT(FILTER(\"Registros_KPI\", AND([Fecha_Calculo] >= TODAY() - 1, [Estado_KPI] = \"Rojo\")))",
          "Icon": "alert-triangle",
          "Color": "Danger"
        },
        {
          "Name": "KPIs en Amarillo (Atención)",
          "Expression": "COUNT(FILTER(\"Registros_KPI\", AND([Fecha_Calculo] >= TODAY() - 1, [Estado_KPI] = \"Amarillo\")))",
          "Icon": "alert-circle",
          "Color": "Warning"
        }
      ]
    }
