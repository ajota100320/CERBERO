  {
    "ViewName": "View_Dashboard_Operaciones_Admin",
    "TableName": "Tarea_Ejecuciones",
    "Type": "Dashboard",
    "Position": 21,
    "ShowIf": "USERROLE(\"Administrador\")",
    "Columns": [
      "Tarea_ID",
      "Sucursal_ID",
      "Estado",
      "Fecha_Ejecucion"
    ],
    "Options": {
      "Charts": [
        {
          "Name": "Cumplimiento Tareas por Sucursal (Semana)",
          "Type": "Bar",
          "Dimension": "[Sucursal_ID].[Nombre]",
          "Measure": "COUNT(FILTER(\"Tarea_Ejecuciones\", AND([Sucursal_ID] = [_THISROW].[Sucursal_ID], [Fecha_Ejecucion] >= TODAY() - 7, [Estado] = \"Completada\"))) / COUNT(FILTER(\"Tarea_Programaciones\", AND([Sucursal_ID] = [_THISROW].[Sucursal_ID], [Es_Activa] = TRUE))) * 100",
          "Filter": "[Fecha_Ejecucion] >= TODAY() - 7"
        },
        {
          "Name": "Incidencias por Tipo y Severidad",
          "Type": "Bar",
          "Dimension": "Tipo",
          "Measure": "COUNT(*)",
          "Filter": "[Fecha_Reporte] >= TODAY() - 30",
          "Series": [
            {
              "Name": "Crítica",
              "Expression": "COUNT(FILTER(\"Incidencias\", AND([Tipo] = [_THISROW].[Tipo], [Severidad] = \"Critica\", [Fecha_Reporte] >= TODAY() - 30)))"
            },
            {
              "Name": "Alta",
              "Expression": "COUNT(FILTER(\"Incidencias\", AND([Tipo] = [_THISROW].[Tipo], [Severidad] = \"Alta\", [Fecha_Reporte] >= TODAY() - 30)))"
            },
            {
              "Name": "Media",
              "Expression": "COUNT(FILTER(\"Incidencias\", AND([Tipo] = [_THISROW].[Tipo], [Severidad] = \"Media\", [Fecha_Reporte] >= TODAY() - 30)))"
            },
            {
              "Name": "Baja",
              "Expression": "COUNT(FILTER(\"Incidencias\", AND([Tipo] = [_THISROW].[Tipo], [Severidad] = \"Baja\", [Fecha_Reporte] >= TODAY() - 30)))"
            }
          ]
        },
        {
          "Name": "Tiempo Medio Resolución por Severidad",
          "Type": "Bar",
          "Dimension": "Severidad",
          "Measure": "AVERAGE([Tiempo_Resolucion_Horas])",
          "Filter": "AND([Estado] = \"Cerrada\", [Fecha_Cierre] >= TODAY() - 30)"
        }
      ],
      "KPIs": [
        {
          "Name": "Tareas Completadas Hoy (Global)",
          "Expression": "COUNT(FILTER(\"Tarea_Ejecuciones\", AND([Fecha_Ejecucion] = TODAY(), [Estado] = \"Completada\")))",
          "Icon": "check-circle",
          "Color": "Success"
        },
        {
          "Name": "Tareas Omitidas Hoy (Global)",
          "Expression": "COUNT(FILTER(\"Tarea_Ejecuciones\", AND([Fecha_Ejecucion] = TODAY(), [Estado] = \"Omitida\")))",
          "Icon": "x-circle",
          "Color": "Danger"
        },
        {
          "Name": "Incidencias Abiertas Críticas/Alta",
          "Expression": "COUNT(FILTER(\"Incidencias\", AND(IN([Severidad], LIST(\"Critica\", \"Alta\")), IN([Estado], LIST(\"Abierta\", \"En_Proceso\")))))",
          "Icon": "alert-triangle",
          "Color": "Danger"
        },
        {
          "Name": "% Capacitaciones al Día (Global)",
          "Expression": "ROUND(COUNT(FILTER(\"Capacitaciones_Usuarios\", [Estado] = \"Completada\")) / COUNT(FILTER(\"Capacitaciones_Usuarios\", [Estado] <> \"Eximida\")) * 100, 1)",
          "Icon": "book-open",
          "Color": "Info"
        }
      ]
    }
  },
  {
    "ViewName": "View_Dashboard_Operaciones_Encargado",
    "TableName": "Tarea_Ejecuciones",
    "Type": "Dashboard",
    "Position": 22,
    "ShowIf": "USERROLE(\"Encargado\")",
    "Columns": [
      "Tarea_ID",
      "Estado",
      "Fecha_Ejecucion"
    ],
    "RowFilter": "IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL()))",
    "Options": {
      "Charts": [
        {
          "Name": "Mis Tareas esta Semana",
          "Type": "Bar",
          "Dimension": "WEEKDAY([Fecha_Ejecucion])",
          "Measure": "COUNT(*)",
          "Filter": "AND([Fecha_Ejecucion] >= TODAY() - 7, [Estado] = \"Completada\")",
          "Series": [
            {
              "Name": "Completadas",
              "Expression": "COUNT(FILTER(\"Tarea_Ejecuciones\", AND([Sucursal_ID] = [_THISROW].[Sucursal_ID], [Fecha_Ejecucion] = [_THISROW].[Fecha_Ejecucion], [Estado] = \"Completada\")))"
            },
            {
              "Name": "Omitidas",
              "Expression": "COUNT(FILTER(\"Tarea_Ejecuciones\", AND([Sucursal_ID] = [_THISROW].[Sucursal_ID], [Fecha_Ejecucion] = [_THISROW].[Fecha_Ejecucion], [Estado] = \"Omitida\")))"
            }
          ]
        },
        {
          "Name": "Incidencias por Estado",
          "Type": "Pie",
          "Dimension": "Estado",
          "Measure": "COUNT(*)",
          "Filter": "IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL()))"
        }
      ],
      "KPIs": [
        {
          "Name": "Tareas Hoy Completadas",
          "Expression": "COUNT(FILTER(\"Tarea_Ejecuciones\", AND([Fecha_Ejecucion] = TODAY(), [Estado] = \"Completada\", IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL())))))",
          "Icon": "check-circle",
          "Color": "Success"
        },
        {
          "Name": "Tareas Hoy Pendientes",
          "Expression": "COUNT(FILTER(\"Tarea_Ejecuciones\", AND([Fecha_Ejecucion] = TODAY(), [Estado] = \"Pendiente\", IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL())))))",
          "Icon": "clock",
          "Color": "Warning"
        },
        {
          "Name": "Incidencias Abiertas Mi Sucursal",
          "Expression": "COUNT(FILTER(\"Incidencias\", AND([Estado] = \"Abierta\", IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL())))))",
          "Icon": "alert-circle",
          "Color": "Warning"
        },
        {
          "Name": "Capacitaciones Vencidas Equipo",
          "Expression": "COUNT(FILTER(\"Capacitaciones_Usuarios\", AND([Estado] = \"Vencida\", IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL())))))",
          "Icon": "alert-triangle",
          "Color": "Danger"
        }
      ]
    }
  }
]