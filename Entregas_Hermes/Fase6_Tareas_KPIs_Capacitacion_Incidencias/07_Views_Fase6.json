      "Charts": [
        {
          "Name": "KPIs por Categoría",
          "Type": "Pie",
          "Dimension": "Categoria",
          "Measure": "COUNT(*)"
        },
        {
          "Name": "Estado KPIs (Último cálculo)",
          "Type": "Bar",
          "Dimension": "[Registros_KPI].[Estado_KPI]",
          "Measure": "COUNT(*)",
          "Filter": "[Registros_KPI].[Fecha_Calculo] >= TODAY() - 1"
