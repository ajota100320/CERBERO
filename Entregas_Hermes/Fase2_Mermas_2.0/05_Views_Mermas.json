  {
    "ViewName": "View_Mermas_Dashboard_KPIs_Encargado",
    "TableName": "Registro_de_Mermas_y_Vencimientos",
    "Type": "Dashboard",
    "Position": 3,
    "ShowIf": "USERROLE(\"Encargado\")",
    "Columns": [
      "Estado_Merma",
      "Costo_Total_Estimado",
      "Tipo_Merma"
    ],
    "RowFilter": "[Sucursal_ID] = LOOKUP(USEREMAIL(), \"Usuarios_Sucursales\", \"Email\", \"Sucursal_ID\")",
    "Options": {
      "Charts": [
        {
          "Name": "Mermas por Estado (Hoy)",
          "Type": "Pie",
          "Dimension": "Estado_Merma",
          "Measure": "COUNT(*)",
          "Filter": "DATE([Fecha_Hora_Evento]) = TODAY()"
        },
        {
          "Name": "Costo Mermas por Tipo (Semana)",
          "Type": "Bar",
          "Dimension": "Tipo_Merma",
          "Measure": "SUM([Costo_Total_Estimado])",
          "Filter": "[Fecha_Hora_Evento] >= TODAY() - 7"
        },
        {
          "Name": "Tendencia Costo Mermas (30 días)",
          "Type": "Line",
          "Dimension": "DATE([Fecha_Hora_Evento])",
          "Measure": "SUM([Costo_Total_Estimado])",
          "Filter": "[Fecha_Hora_Evento] >= TODAY() - 30"
        }
      ],
      "KPIs": [
        {
          "Name": "Mermas Pendientes",
          "Expression": "COUNT(FILTER(\"Registro_de_Mermas_y_Vencimientos\", AND([Estado_Merma] = \"Pendiente\", [Sucursal_ID] = LOOKUP(USEREMAIL(), \"Usuarios_Sucursales\", \"Email\", \"Sucursal_ID\"))))",
          "Icon": "alert-circle",
          "Color": "Warning"
        },
        {
          "Name": "Costo Mermas Aprobadas Hoy",
          "Expression": "SUM(FILTER(\"Registro_de_Mermas_y_Vencimientos\", AND([Estado_Merma] = \"Aprobada\", DATE([Fecha_Aprobacion]) = TODAY(), [Sucursal_ID] = LOOKUP(USEREMAIL(), \"Usuarios_Sucursales\", \"Email\", \"Sucursal_ID\")))[Costo_Total_Estimado])",
          "Icon": "currency-dollar",
          "Color": "Danger"
        },
        {
          "Name": "Top Ingrediente con Mermas (Semana)",
          "Expression": "TOP(FILTER(\"Registro_de_Mermas_y_Vencimientos\", AND([Fecha_Hora_Evento] >= TODAY() - 7, [Sucursal_ID] = LOOKUP(USEREMAIL(), \"Usuarios_Sucursales\", \"Email\", \"Sucursal_ID\"))), 1, \"Ingrediente_ID\", \"Costo_Total_Estimado\")[Ingrediente_ID]",
          "Icon": "trending-up",
          "Color": "Info"
        }
      ]
    }
  }
]