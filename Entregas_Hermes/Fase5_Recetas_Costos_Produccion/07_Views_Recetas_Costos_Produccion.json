  {
    "ViewName": "View_Dashboard_Costos_Produccion_Admin",
    "TableName": "Produccion",
    "Type": "Dashboard",
    "Position": 14,
    "ShowIf": "USERROLE(\"Administrador\")",
    "Columns": [
      "Receta_ID",
      "Sucursal_ID",
      "Estado",
      "Fecha_Produccion",
      "Costo_Teorico_Total",
      "Costo_Real_Total",
      "Variacion_Costo"
    ],
    "Options": {
      "Charts": [
        {
          "Name": "Producciones por Estado",
          "Type": "Pie",
          "Dimension": "Estado",
          "Measure": "COUNT(*)"
        },
        {
          "Name": "Costo Teórico vs Real por Receta (Mes)",
          "Type": "Bar",
          "Dimension": "[Receta_ID].[Nombre]",
          "Measure": "SUM([Costo_Real_Total])",
          "Filter": "AND(MONTH([Fecha_Produccion]) = MONTH(TODAY()), [Estado] = \"Completada\")",
          "Series": [
            {
              "Name": "Teórico",
              "Expression": "SUM([Costo_Teorico_Total])"
            },
            {
              "Name": "Real",
              "Expression": "SUM([Costo_Real_Total])"
            }
          ]
        },
        {
          "Name": "Variación % Costo por Sucursal (Mes)",
          "Type": "Bar",
          "Dimension": "[Sucursal_ID].[Nombre]",
          "Measure": "AVERAGE([Variacion_Costo] / [Costo_Teorico_Total] * 100)",
          "Filter": "AND(MONTH([Fecha_Produccion]) = MONTH(TODAY()), [Estado] = \"Completada\")"
        },
        {
          "Name": "Top 5 Ingredientes con Mayor Variación (Mes)",
          "Type": "Table",
          "Dimension": "[Produccion_Detalle].[Ingrediente_ID].[Nombre]",
          "Measure": "AVERAGE([Merma_Real_Porcentaje])",
          "Filter": "AND(MONTH([Produccion_ID].[Fecha_Produccion]) = MONTH(TODAY()), [Produccion_ID].[Estado] = \"Completada\")",
          "Options": {
            "SortBy": "Measure",
            "SortOrder": "Descending",
            "Limit": 5
          }
        }
      ],
      "KPIs": [
        {
          "Name": "Producciones En Proceso Hoy",
          "Expression": "COUNT(FILTER(\"Produccion\", AND([Estado] = \"En_Proceso\", DAY([Fecha_Produccion]) = DAY(TODAY()))))",
          "Icon": "factory",
          "Color": "Info"
        },
        {
          "Name": "Variación Promedio Costo (Mes)",
          "Expression": "AVERAGE(FILTER(\"Produccion\", AND([Estado] = \"Completada\", MONTH([Fecha_Produccion]) = MONTH(TODAY()))), [Variacion_Costo] / [Costo_Teorico_Total] * 100)",
          "Icon": "trending-up",
          "Color": "Warning"
        },
        {
          "Name": "Recetas Aprobadas Activas",
          "Expression": "COUNT(FILTER(\"Recetas\", AND([Estado] = \"Aprobada\", [Es_Activa?] = TRUE)))",
          "Icon": "clipboard-check",
          "Color": "Success"
        },
        {
          "Name": "Alertas Costo Crítico Pendientes",
          "Expression": "COUNT(FILTER(\"Costos_Historicos\", AND([Fecha_Cambio] >= TODAY() - 7, ABS([Variacion_Porcentaje]) > LOOKUP(\"UMBRAL_VARIACION_COSTO_CRITICA\", \"Config_Global\", \"Clave\", \"Valor\"), [Activo?] = TRUE)))",
          "Icon": "alert-triangle",
          "Color": "Danger"
        }
      ]
    }
  },
  {
    "ViewName": "View_Dashboard_Produccion_Encargado",
    "TableName": "Produccion",
    "Type": "Dashboard",
    "Position": 15,
    "ShowIf": "USERROLE(\"Encargado\")",
    "Columns": [
      "Receta_ID",
      "Estado",
      "Fecha_Produccion",
      "Costo_Teorico_Total",
      "Costo_Real_Total"
    ],
    "RowFilter": "IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL()))",
    "Options": {
      "Charts": [
        {
          "Name": "Producciones esta semana",
          "Type": "Bar",
          "Dimension": "WEEKDAY([Fecha_Produccion])",
          "Measure": "COUNT(*)",
          "Filter": "AND([Fecha_Produccion] >= TODAY() - 7, [Estado] = \"Completada\")"
        },
        {
          "Name": "Costo Teórico vs Real por Receta",
          "Type": "Bar",
          "Dimension": "[Receta_ID].[Nombre]",
          "Measure": "SUM([Costo_Real_Total])",
          "Filter": "AND(MONTH([Fecha_Produccion]) = MONTH(TODAY()), [Estado] = \"Completada\")",
          "Series": [
            {
              "Name": "Teórico",
              "Expression": "SUM([Costo_Teorico_Total])"
            },
            {
              "Name": "Real",
              "Expression": "SUM([Costo_Real_Total])"
            }
          ]
        }
      ],
      "KPIs": [
        {
          "Name": "Produciendo ahora",
          "Expression": "COUNT(FILTER(\"Produccion\", AND([Estado] = \"En_Proceso\", IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL())))))",
          "Icon": "factory",
          "Color": "Info"
        },
        {
          "Name": "Completadas esta semana",
          "Expression": "COUNT(FILTER(\"Produccion\", AND([Estado] = \"Completada\", [Fecha_Produccion] >= TODAY() - 7, IN([Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL())))))",
          "Icon": "check-circle",
          "Color": "Success"
        }
      ]
    }
  }
]