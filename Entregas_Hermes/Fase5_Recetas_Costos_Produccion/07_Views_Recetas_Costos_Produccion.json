  {
    "ViewName": "View_Produccion_Formulario_Nueva",
    "TableName": "Produccion",
    "Type": "Form",
    "Position": 9,
    "ShowIf": "OR(USERROLE(\"Encargado\"), USERROLE(\"Operador\"))",
    "Columns": [
      "Receta_ID",
      "Cantidad_Producida",
      "Unidad_Produccion",
      "Observaciones"
    ],
    "RowFilter": "AND([Receta_ID].[Estado] = \"Aprobada\", [Receta_ID].[Es_Activa?] = TRUE, IN([Receta_ID].[Sucursal_ID], SELECT(Usuarios_Sucursales[Sucursal_ID], [Email] = USEREMAIL())))",
    "InitialValues": {
      "Estado": "\"En_Proceso\"",
      "Producida_Por": "USEREMAIL()",
      "Fecha_Produccion": "NOW()",
      "Lote": "CONCATENATE(\"LOTE-\", YEAR(NOW()), MONTH(NOW()), DAY(NOW()), \"-\", RANDBETWEEN(100,999))",
      "Sucursal_ID": "LOOKUP([Receta_ID], \"Recetas\", \"Receta_ID\", \"Sucursal_ID\")",
      "Costo_Teorico_Total": "[Cantidad_Producida] * LOOKUP([Receta_ID], \"Recetas\", \"Receta_ID\", \"Costo_Por_Porciona\")",
      "Sync_Pending?": "TRUE"
    },
    "Options": {
      "ShowCancelButton": true,
      "ShowSaveButton": true
    }
  },
